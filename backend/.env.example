# Copy this file to .env (same folder) and fill in real values only for the
# features you actually want to turn on. .env is excluded by .gitignore and
# must never be committed. This file is the only one that is committed - it
# must only ever contain placeholders.

# --- AI question generation (Phase 5) ---
# Used ONLY to generate interview QUESTIONS (role/category/difficulty-aware).
# This flag does NOT turn on answer evaluation/scoring - see
# AI_EVALUATION_ENABLED below, which is a completely separate switch.
# Both lines below must be set for AI generation to be attempted; leaving
# either one unset (the default) means the backend keeps using the existing
# fixed sample question bank, with no error and no cost.
# AI_QUESTIONS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- AI answer evaluation and scoring (Phase 8) ---
# Used ONLY to score/evaluate an already-submitted answer. Completely
# independent of AI_QUESTIONS_ENABLED above - turning one on never turns
# on the other. Reuses the same OPENAI_API_KEY/OPENAI_MODEL above. Leaving
# this unset (the default) means evaluation requests get a clear "not
# configured" error instead of ever calling the provider - no error, but
# also no score, and definitely no cost.
# AI_EVALUATION_ENABLED=false

# --- SQLite database (Phase 6) ---
# Where the interview database file lives. Leaving this unset (the default)
# stores it at backend/data/prepai.db, created automatically on first use.
# Only set this if you want the file somewhere else.
# DATABASE_PATH=

# --- Authentication (Phase 7) ---
# Sessions are random tokens stored in the database, not JWTs, so there is
# no app-wide secret key to configure here. These two are optional - safe
# defaults apply if you leave them unset.
#
# How many days a login stays valid before it must be renewed by logging
# in again. Defaults to 7 if unset.
# SESSION_LIFETIME_DAYS=7
#
# Whether the session/CSRF cookies get the `Secure` attribute (only sent
# over HTTPS). Defaults to false, which is correct for local HTTP
# development on 127.0.0.1. Set this to true when you deploy over real
# HTTPS - never leave it false in production.
# SESSION_COOKIE_SECURE=false

# --- Future phases ---
# DATABASE_URL=
