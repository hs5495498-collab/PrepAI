# Copy this file to .env (same folder) and fill in real values only for the
# features you actually want to turn on. .env is excluded by .gitignore and
# must never be committed. This file is the only one that is committed - it
# must only ever contain placeholders.

# --- AI question generation (Phase 5) ---
# Used ONLY to generate interview QUESTIONS (role/category/difficulty-aware).
# This flag does NOT turn on answer evaluation/scoring - see
# AI_EVALUATION_ENABLED below, which is a completely separate switch.
# Both lines below must be set for AI generation to be attempted; leaving
# either one unset (the default) means the backend keeps using the existing
# fixed sample question bank, with no error and no cost.
# AI_QUESTIONS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- AI answer evaluation and scoring (Phase 8) ---
# Used to score/evaluate submitted answers. Completely independent of
# AI_QUESTIONS_ENABLED above - turning one on never turns on the other.
# Reuses the same OPENAI_API_KEY/OPENAI_MODEL above. Leaving this unset
# (the default) means evaluation requests get a clear "not configured"
# error instead of ever calling the provider - no error, but also no
# score, and definitely no cost.
#
# When set to true: completing an interview (POST .../complete)
# automatically evaluates every answered question that isn't evaluated
# yet, and the response includes an overall_score out of 100 (the mean of
# the evaluated questions' scores), evaluated_count, and an
# evaluation_status of "complete"/"partial"/"not_evaluated" - a provider
# failure for one or more questions never fails completion itself, just
# leaves those questions unevaluated (status "partial" or "not_evaluated")
# and retryable later via the existing per-question "Evaluate with AI"
# button, which still works exactly as before as a manual retry/re-check.
# AI_EVALUATION_ENABLED=false

# --- Mock (simulated) answer evaluation - development only ---
# For demoing/testing the full interview workflow (results page, overall
# score, history, analytics) WITHOUT an OpenAI API key and WITHOUT making
# any real/paid API call. Every mock result is clearly labeled
# "SIMULATED - NOT AI-GENERATED" in both the UI and the API response
# (is_simulated=true, note, and model="mock-simulated-v1"), and scores are
# computed deterministically from the submitted answer - never random,
# and never presented as a genuine AI assessment.
#
# Requires ALL of the following to actually take effect:
#   1. MOCK_EVALUATION_ENABLED=true (unset/false by default)
#   2. ENVIRONMENT is NOT "production"/"prod" (unset defaults to
#      "development", which is correct for local use - a real production
#      deployment must set ENVIRONMENT=production, which then forces mock
#      mode off even if MOCK_EVALUATION_ENABLED was left on by mistake)
#   3. The real provider above is NOT already configured (AI_EVALUATION_ENABLED
#      + OPENAI_API_KEY) - a working real setup always takes priority, so
#      mock mode can never silently replace a genuine evaluation.
# MOCK_EVALUATION_ENABLED=false
# ENVIRONMENT=development

# --- SQLite database (Phase 6) ---
# Where the interview database file lives. Leaving this unset (the default)
# stores it at backend/data/prepai.db, created automatically on first use.
# Only set this if you want the file somewhere else.
# DATABASE_PATH=

# --- Authentication (Phase 7) ---
# Sessions are random tokens stored in the database, not JWTs, so there is
# no app-wide secret key to configure here. These two are optional - safe
# defaults apply if you leave them unset.
#
# How many days a login stays valid before it must be renewed by logging
# in again. Defaults to 7 if unset.
# SESSION_LIFETIME_DAYS=7
#
# Whether the session/CSRF cookies get the `Secure` attribute (only sent
# over HTTPS). Defaults to false, which is correct for local HTTP
# development on 127.0.0.1. Set this to true when you deploy over real
# HTTPS - never leave it false in production.
# SESSION_COOKIE_SECURE=false

# --- Future phases ---
# DATABASE_URL=
