{
  "info": {
    "_postman_id": "361c5719-0610-4311-8454-21799e5c58d5",
    "name": "PrepAI Backend API",
    "description": "Verification collection for the PrepAI FastAPI backend, built directly from the live OpenAPI schema (GET /openapi.json) and backend/auth.py's actual cookie/header names - no invented endpoints, fields, or auth mechanics. Uses dedicated, dynamically-generated test accounts (postman-a-*/postman-b-*@example.com) - never your real account. Run top-to-bottom, folder order matters (later requests depend on variables captured by earlier ones). See docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "1.1 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status: ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
                  ""
