    {
      "name": "5. AI Evaluation (honest check - works whether configured or not)",
      "item": [
        {
          "name": "5.1 Evaluate Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token_a}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}/questions/{{question_id}}/evaluate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}",
                "questions",
                "{{question_id}}",
                "evaluate"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This request intentionally branches on the server's actual configuration",
                  "// instead of presuming AI evaluation is on or off - see docs/postman/README.md.",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"[CONFIGURED] total_score is within 0-100\", () => {",
                  "    pm.expect(body.total_score).to.be.at.least(0).and.at.most(100);",
                  "  });",
                  "  pm.test(\"[CONFIGURED] note discloses this is an estimate, not an objective measurement\", () => {",
                  "    pm.expect(body.note.toLowerCase()).to.include(\"estimate\");",
                  "  });",
                  "  console.log(\"AI evaluation is CONFIGURED on this server - real provider call occurred for this request.\");",
                  "} else {",
                  "  pm.test(\"[NOT CONFIGURED] honest 503 with a clear reason, never a fabricated score\", () => {",
                  "    pm.response.to.have.status(503);",
                  "    pm.expect(pm.response.json().detail.toLowerCase()).to.include(\"not configured\");",
                  "  });",
                  "  console.log(\"AI evaluation is NOT configured on this server - honest 503 confirmed, no score fabricated.\");",
                  "}",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
