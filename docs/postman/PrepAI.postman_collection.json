              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404 (never reveals that the interview exists)\", () => pm.response.to.have.status(404));",
                  "pm.test(\"no private fields (role, questions, answers) leaked alongside the error\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('role');",
                  "  pm.expect(body).to.not.have.property('questions');",
                  "});",
                  ""
