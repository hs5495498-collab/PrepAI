    {
      "name": "3. Interview Lifecycle (Account A)",
      "item": [
        {
          "name": "3.1 Create Interview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token_a}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/interviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Backend Developer (Postman Test)\",\n  \"category\": \"technical\",\n  \"difficulty\": \"easy\",\n  \"question_count\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"total_questions matches request\", () => pm.expect(body.total_questions).to.eql(3));",
                  "pm.test(\"status is in_progress\", () => pm.expect(body.status).to.eql(\"in_progress\"));",
                  "pm.collectionVariables.set('session_id', body.session_id);",
                  "pm.collectionVariables.set('question_id', body.questions[0].id);",
                  "pm.test(\"session_id and first question_id captured\", () => {",
                  "  pm.expect(pm.collectionVariables.get('session_id')).to.be.a('string').and.not.empty;",
                  "  pm.expect(pm.collectionVariables.get('question_id')).to.be.a('string').and.not.empty;",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Retrieve Interview Session & Questions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"session_id matches\", () => pm.expect(body.session_id).to.eql(pm.collectionVariables.get('session_id')));",
                  "pm.test(\"has 3 questions\", () => pm.expect(body.questions.length).to.eql(3));",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Submit Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token_a}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}/answers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}",
                "answers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{question_id}}\",\n  \"answer\": \"A real, substantive Postman test answer about this question.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"answered_count is 1\", () => pm.expect(pm.response.json().answered_count).to.eql(1));",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Verify Saved Answer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const q = body.questions.find(q => q.id === pm.collectionVariables.get('question_id'));",
                  "pm.test(\"the submitted answer was actually persisted\", () => {",
                  "  pm.expect(q).to.not.be.undefined;",
                  "  pm.expect(q.answer).to.eql(\"A real, substantive Postman test answer about this question.\");",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Complete Interview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token_a}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}",
                "complete"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 (or 409 if this request was already run once)\", () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"status is completed\", () => pm.expect(body.status).to.eql(\"completed\"));",
                  "  pm.test(\"evaluation_status is one of the documented values\", () => {",
                  "    pm.expect([\"not_configured\", \"not_evaluated\", \"partial\", \"complete\"]).to.include(body.evaluation_status);",
                  "  });",
                  "  pm.test(\"overall_score is never 0 as a substitute for missing evaluation\", () => {",
                  "    if (body.evaluated_count === 0) { pm.expect(body.overall_score).to.be.null; }",
                  "  });",
                  "}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Retrieve Final Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interviews/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interviews",
                "{{session_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"session is completed\", () => pm.expect(body.status).to.eql(\"completed\"));",
                  "pm.test(\"evaluation_status is honestly reported\", () => {",
                  "  pm.expect([\"not_configured\", \"not_evaluated\", \"partial\", \"complete\"]).to.include(body.evaluation_status);",
                  "});",
                  "console.log(\"Evaluation status for this run:\", body.evaluation_status, \"| overall_score:\", body.overall_score);",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
